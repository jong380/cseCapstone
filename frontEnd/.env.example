# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys.

# Groq API key for the chat assistant.
# Get a free key at https://console.groq.com
EXPO_PUBLIC_GROQ_API_KEY=YOUR GROQ API KEY

# URL of the Nodi Express backend (backEnd/index.js).
# Pick the value that matches where you run the app:
#   - iOS simulator / web:  http://localhost:3000
#   - Android emulator:     http://10.0.2.2:3000
#   - Physical device:      http://<your-laptop-LAN-ip>:3000
# Uncomment the line below and replace with the correct URL for your backend.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
